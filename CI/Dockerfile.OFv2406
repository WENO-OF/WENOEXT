# --------------------------------------------------------------------------- #
# Docker Instructions for OpenFOAM v2406                                      #
# --------------------------------------------------------------------------- #
#                                                                             #
# Installs OpenFOAM v2406 (precompiled package) and Eigen 3.4 in              #
# Ubuntu 24.04 LTS, compiles the library and runs the unit tests              #
# --------------------------------------------------------------------------- #

FROM ubuntu:24.04

CMD [ "/bin/sh" ]

ENV DEBIAN_FRONTEND=noninteractive

# Install all required packages
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg git cmake build-essential gnuplot \
        libeigen3-dev \
 && curl -fsSL https://dl.openfoam.com/add-debian-repo.sh | bash \
 && apt-get update \
 && apt-get install -y openfoam2406-dev \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

ENV foamDotFile=/usr/lib/openfoam/openfoam2406/etc/bashrc

# The parallel tests run with 8 processes, allow more processes than cores
ENV OMPI_MCA_rmaps_base_oversubscribe=1

# This has to be done as RUN executes /bin/sh and the
# source of the OpenFOAM bashrc requires /bin/bash
RUN rm -f /bin/sh && ln -sT /bin/bash /bin/sh

# Create a gitlab user and group
# This is required for GitLab CI
RUN groupadd -g 999 gitlab \
 && useradd -m -d /home/gitlab -r -u 999 -g gitlab gitlab
USER gitlab

# Create lib directory
RUN mkdir -p /home/gitlab/build/
WORKDIR /home/gitlab/build

# Bundle lib source
COPY --chown=gitlab:gitlab . .

# Update git submodules
RUN git submodule init && git submodule update

# First compile the code
RUN . $foamDotFile && ./Allwclean && ./Allwmake -f -j

# Run all unit tests
RUN . $foamDotFile && cd tests && ./runTest
